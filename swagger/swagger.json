{
    "swagger": "2.0",
    "info": {
        "description": "Bible text service — works, books, verses, search, and cross-translation comparison.",
        "title": "Word API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/health": {
            "get": {
                "description": "Returns liveness status.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/books": {
            "get": {
                "description": "Returns all 66 canonical books in order.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "books"
                ],
                "summary": "List canonical books",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_mbarlow_word_internal_model.Book"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_api_handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/compare": {
            "get": {
                "description": "Returns a verse from multiple works/translations side by side.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "text"
                ],
                "summary": "Compare verse across works",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Comma-separated work codes (e.g. kjv,heb-wlc)",
                        "name": "works",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Verse reference as BOOK.CHAPTER.VERSE (e.g. GEN.1.1)",
                        "name": "ref",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "$ref": "#/definitions/github_com_mbarlow_word_internal_model.Verse"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_api_handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/random-verse": {
            "get": {
                "description": "Returns a random verse with optional filtering by work, book, or testament.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "text"
                ],
                "summary": "Get a random verse",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Filter by work code",
                        "name": "work",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter by OSIS book code",
                        "name": "book",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter by testament (OT or NT)",
                        "name": "testament",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_mbarlow_word_internal_model.Verse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_api_handler.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/internal_api_handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/search": {
            "get": {
                "description": "Full-text search across verses, optionally filtered by work.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "search"
                ],
                "summary": "Search verses",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Search query",
                        "name": "q",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Filter by work code",
                        "name": "work",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Max results (1-100, default 50)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_api_handler.SearchResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_api_handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_api_handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/text/{work}/{book}/{chapter}": {
            "get": {
                "description": "Returns all verses for a given work, book, and chapter.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "text"
                ],
                "summary": "Get chapter text",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Work code (e.g. kjv, heb-wlc)",
                        "name": "work",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "OSIS book code (e.g. GEN, PSA)",
                        "name": "book",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Chapter number",
                        "name": "chapter",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_api_handler.ChapterResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_api_handler.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/internal_api_handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_api_handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/verse/{work}/{book}/{chapter}/{verse}": {
            "get": {
                "description": "Returns a single verse by work, book, chapter, and verse number.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "text"
                ],
                "summary": "Get a single verse",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Work code",
                        "name": "work",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "OSIS book code",
                        "name": "book",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Chapter number",
                        "name": "chapter",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Verse number",
                        "name": "verse",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_mbarlow_word_internal_model.Verse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/internal_api_handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/v1/works": {
            "get": {
                "description": "Returns all Bible works/translations in the database.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "works"
                ],
                "summary": "List available works",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/github_com_mbarlow_word_internal_model.Work"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_api_handler.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "github_com_mbarlow_word_internal_model.Book": {
            "type": "object",
            "properties": {
                "chapters": {
                    "description": "Number of chapters",
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "order": {
                    "description": "Canonical order (1-66)",
                    "type": "integer"
                },
                "osis": {
                    "description": "3-letter OSIS code",
                    "type": "string"
                },
                "slug": {
                    "type": "string"
                },
                "testament": {
                    "description": "OT or NT",
                    "type": "string"
                }
            }
        },
        "github_com_mbarlow_word_internal_model.Verse": {
            "type": "object",
            "properties": {
                "book_slug": {
                    "type": "string"
                },
                "chapter": {
                    "type": "integer"
                },
                "createdAt": {
                    "type": "string"
                },
                "id": {
                    "description": "VID: work/osis/chapter/verse",
                    "type": "string"
                },
                "lang": {
                    "type": "string"
                },
                "meta": {
                    "description": "JSON: optional metadata",
                    "type": "string"
                },
                "osis": {
                    "type": "string"
                },
                "source": {
                    "description": "JSON: upstream, artifact, sha256",
                    "type": "string"
                },
                "text": {
                    "type": "string"
                },
                "updatedAt": {
                    "type": "string"
                },
                "verse": {
                    "type": "integer"
                },
                "work": {
                    "type": "string"
                }
            }
        },
        "github_com_mbarlow_word_internal_model.Work": {
            "type": "object",
            "properties": {
                "createdAt": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "description": "e.g., \"kjv\", \"heb-wlc\"",
                    "type": "string"
                },
                "lang": {
                    "type": "string"
                },
                "license": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "source_url": {
                    "type": "string"
                },
                "updatedAt": {
                    "type": "string"
                }
            }
        },
        "internal_api_handler.ChapterResponse": {
            "type": "object",
            "properties": {
                "book": {
                    "type": "string"
                },
                "chapter": {
                    "type": "integer"
                },
                "verses": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/github_com_mbarlow_word_internal_model.Verse"
                    }
                },
                "work": {
                    "type": "string"
                }
            }
        },
        "internal_api_handler.ErrorResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                }
            }
        },
        "internal_api_handler.SearchResponse": {
            "type": "object",
            "properties": {
                "count": {
                    "type": "integer"
                },
                "query": {
                    "type": "string"
                },
                "results": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/github_com_mbarlow_word_internal_model.Verse"
                    }
                }
            }
        }
    }
}